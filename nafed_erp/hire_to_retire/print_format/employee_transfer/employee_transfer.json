 "html": "<div>\n    {% if letter_head and not no_letterhead %}\n            <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n\n</div>\n{% block content %}\n{% set designation = frappe.db.get_value(\"Employee\", doc.employee, \"designation\") %}\n\n<table style=\"width:100%; font-size:15px; border-collapse:collapse; line-height:1.6;\">\n    <tr\n        <td colspan=\"2\" style=\"text-align:left; padding-top:10px;\">\n            <h3 style=\"text-decoration:underline;\">{{doc.name}} </h3>\n        </td>\n       \n    </tr>\n\n    <tr>\n        <td colspan=\"2\" style=\"text-align:center; padding-top:10px;\">\n            <h3 style=\"text-decoration:underline;\">OFFICE MEMORANDUM</h3>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <p>It has been decided by the Competent Authority to transfer the following employee with immediate effect:</p>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <table border=\"1\" style=\"width:100%; border-collapse:collapse; text-align:left;\">\n                <tr>\n                    <th style=\"padding:5px;\">Sr. No.</th>\n                    <th style=\"padding:5px;\">Name & Designation</th>\n                    <th style=\"padding:5px;\">From</th>\n                    <th style=\"padding:5px;\">To</th>\n                </tr>\n                {% for row in doc.transfer_details %}\n                <tr>\n                    <td style=\"padding:5px;\">{{ loop.index }}</td>\n                    <td style=\"padding:5px;\">{{ doc.employee_name }},{{ designation }}</td>\n                    <td style=\"padding:5px;\">{{ row.current }}</td>\n                    <td style=\"padding:5px;\">{{ row.new }}</td>\n                </tr>\n                {% endfor %}\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\" style=\"padding-top:10px;\">\n            <p>2. Accordingly, concerned Divisional Heads and State Head are requested to immediately relieve the above-named employee enabling them to report at their respective locations under intimation to Head Office.</p>\n\n            <p>3. Since, Shri {{ doc.employee_name }} is transferred on his own request, he/she will not be eligible to transfer benefits except actual journey time only as per rules.</p>\n\n            <p>4. This issues with the approval of the Competent Authority.</p>\n        </td>\n    </tr>\n\n    <tr>\n        <td style=\"width:60%;\"></td>\n        <td style=\"text-align:right; padding-top:20px;\">\n            <strong>(Anand Mohan, IRTS)</strong><br>\n            Joint Managing Director (Pers)\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\" style=\"padding-top:20px;\">\n            <strong >Above-named individual</strong><br>\n            <strong>Copy to:</strong>\n            <ol style=\"margin-top:5px; margin-bottom:0;\">\n                <li>Joint MD(KDV), HO</li>\n                <li>AMDs/ED, HO</li>\n                <li>GM (F&A) HO</li>\n                <li>RH(EZ)/SH-Raipur</li>\n                <li>OSD/PS/PA to Hon\u2019ble Chairman</li>\n                <li>MD Cell</li>\n                <li>Pers./ Guard/ Stat Files.</li>\n            </ol>\n        </td>\n    </tr>\n</table>\n\n<hr style=\"margin-top:20px;\">\n<table style=\"width:100%; font-size:12px;\">\n    \n</table>\n{% endblock %}\n",
