 "html": "<!----------------------------------Letter Head-------------------------------------->\n\n<div>\n    {% if letter_head and not no_letterhead %}\n            <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n\n</div>\n\n<!----------------------------------Content-------------------------------------->\n\n<table class=\"table-content\">\n    {% set current_year = frappe.utils.now_datetime().year %}\n    {% set next_year = (current_year + 1) % 100 %}\n    {% set financial_year = \"{}-{}\".format(current_year, next_year) %}\n    <tr>\n        <td>\n            <p class=\"text-left\">\n                HO/AD/P-167/M/{{financial_year}}\n            </p>\n        </td>\n        <td>\n            <p class=\"text-right\">\n                Dated: {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"dd.MM.yyyy\") }}\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" class=\"text-center\">\n            <b>\n                OFFICE MEMORANDUM\n            </b>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" style=\"margin-left: 10px;\">\n            <p>\n            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;The Services of {{doc.salutation}}. {{doc.employee_name}}, \n            Assistant Manager(A/Cs) in the pay scale of Rs. {{doc.minimum_pay_scale}}-{{doc.maximum_pay_scale}} are hereby confirmed to her existing post \n            with effect from {{ frappe.utils.formatdate(doc.date_of_confirmation, \"dd.MM.yyyy\") or '' }}\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\">\n            <div style=\"margin-top: 25px;\">\n                \n            </div>\n        </td>\n    </tr>\n    <tr>\n        <td class=\"text-right\" colspan=\"2\">\n            <p>\n                (Deepak Chhikara)\n            </p>\n            <p>\n                Manager (Pers.)\n            </p>\n            <p>\n                For Addl. Managing Director(Pers.)\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\">\n            <p>\n                {{doc.salutation}}. {{doc.employee_name}}\n            </p>\n            <p>\n                AM(A/Cs)\n            </p>\n            <p>\n                Hyderabad\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\">\n            <div style=\"margin-top: 10px;\">\n                \n            </div>\n        </td>\n    </tr>\n    <tr>\n        <td>\n            <p>\n                Cc to:\n            </p>\n            <p style=\"margin-left: 40px;\">\n                1. GM (F&A), HO\n            </p>\n            <p style=\"margin-left: 40px;\">\n                2. PS to MD\n            </p>\n            <p style=\"margin-left: 40px;\">\n                3. Guard/Stats./Personnel File\n            </p>\n        </td>\n    </tr>\n</table>\n<!----------------------------------Footer Head-------------------------------------->\n\n<style>\n@media print {\n    .print-footer {\n        position: fixed;\n        bottom: 0;\n        left: 0;\n        right: 0;\n        text-align: center;\n        font-size: 10px;\n    }\n    .print-footer .letter-head {\n        margin-bottom: 5px;\n    }\n}\n</style>\n<div class=\"print-footer\">\n    {% if doc.letter_head %}\n    <div class=\"letter-head\">\n        {{ frappe.render_template(frappe.db.get_value(\"Letter Head\", doc.letter_head, \"footer\"), {\"doc\": doc}) }}\n    </div>\n    {% endif %}\n    <p class=\"text-center small page-number page-number visible-pdf\">\n        Page <span class=\"page-number\"></span> of <span class=\"total-pages\"></span>\n    </p>\n</div>",
