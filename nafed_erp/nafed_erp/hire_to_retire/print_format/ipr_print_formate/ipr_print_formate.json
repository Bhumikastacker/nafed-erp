 "doctype": "Print Format",
 "font_size": 14,
 "html": "<table width=\"100%\" style=\"font-family: Arial, sans-serif; font-size: 12px; color: #000; line-height: 1.4; border-collapse: collapse;\">\n    \n    <tr>\n        <td align=\"center\" style=\"padding-bottom: 25px;\">\n            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td align=\"center\">\n                        {% if doc.company_logo %}\n                            <img src=\"{{ doc.company_logo }}\" style=\"max-height: 70px; display: block;\">\n                        {% endif %}\n                    </td>\n                </tr>\n                <tr>\n                    <td align=\"center\" style=\"padding-top: 10px;\">\n                        <span style=\"font-size: 22px; font-weight: bold; text-transform: uppercase;\">NAFED</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td align=\"center\" style=\"padding-top: 5px;\">\n                        <span style=\"font-size: 14px; font-weight: bold; text-transform: uppercase;\">\n                            STATEMENT OF IMMOVABLE PROPERTY RETURN\n                        </span>\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td style=\"padding-bottom: 15px;\">\n            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"5\">\n                <tr>\n                    <td width=\"15%\" style=\"white-space: nowrap;\">Name of the Employee:</td>\n                    \n                    <td width=\"40%\" style=\"border-bottom: 1px dotted #000; font-weight: bold; text-align: center; vertical-align: bottom;\">\n                        {{ frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") or doc.employee }}\n                    </td>\n\n                    <td width=\"15%\" align=\"right\" style=\"white-space: nowrap;\">Year Ending:</td>\n                    \n                    <td width=\"30%\" style=\"border-bottom: 1px dotted #000; font-weight: bold; text-align: center; vertical-align: bottom;\">\n                        {{ frappe.utils.get_datetime(doc.creation).year }}\n                    </td>\n                </tr>\n                \n                <tr>\n                    <td style=\"white-space: nowrap;\">1. Designation:</td>\n                    \n                    <td style=\"border-bottom: 1px dotted #000; font-weight: bold; text-align: center; vertical-align: bottom;\">\n                        {{ doc.designation }}\n                    </td>\n\n                    <td align=\"right\" style=\"white-space: nowrap;\">2. Basic Pay:</td>\n                    \n                    <td style=\"border-bottom: 1px dotted #000; font-weight: bold; text-align: center; vertical-align: bottom;\">\n                        {{ doc.get_formatted(\"basic_pay\") or \"0.00\" }}\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td style=\"padding-bottom: 20px;\">\n            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td valign=\"middle\">\n                        <span style=\"display: inline-block; width: 14px; height: 14px; border: 1px solid #000; text-align: center; vertical-align: middle; line-height: 12px; font-weight: bold; margin-right: 5px;\">\n                            {% if doc.not_applicable %}&#10003;{% else %}&nbsp;{% endif %}\n                        </span>\n                        <strong>Not Applicable</strong>\n                        <span style=\"font-size: 11px; color: #555; margin-left: 10px;\">\n                            (Check not applicable, in case you don't have any property)\n                        </span>\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td>\n            <table width=\"100%\" border=\"1\" cellspacing=\"0\" cellpadding=\"5\" style=\"border-collapse: collapse; border-color: #000; font-size: 11px;\">\n                <thead>\n                    <tr style=\"background-color: #f5f5f5;\">\n                        <th width=\"4%\" align=\"center\">#</th>\n                        <th width=\"20%\" align=\"center\">Name of District, Sub-Division, Taluk, Village in which property is situated</th>\n                        <th width=\"14%\" align=\"center\">Name & details of property</th>\n                        <th width=\"13%\" align=\"center\">Present value (*)</th>\n                        <th width=\"14%\" align=\"center\">If not in own name state in whose name held & relationship</th>\n                        <th width=\"20%\" align=\"center\">How acquired whether purchase, lease mortgage, inheritance, gift or otherwise with date of acquisition & name with details of persons from whom acquired (**)</th>\n                        <th width=\"13%\" align=\"center\">Amount Income from the property</th>\n                        <th width=\"8%\" align=\"center\">Remarks</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% if doc.details %}\n                        {% for row in doc.details %}\n                        <tr>\n                            <td align=\"center\" valign=\"top\">{{ loop.index }}</td>\n                            <td align=\"left\" valign=\"top\">\n                                {% if row.name_of_district %} {{ row.name_of_district }}<br> {% endif %}\n                                {% if row.sub_division %} {{ row.sub_division }}<br> {% endif %}\n                                {% if row.taluk %} {{ row.taluk }}<br> {% endif %}\n                                {% if row.village %} {{ row.village }} {% endif %}\n                            </td>\n                            <td align=\"left\" valign=\"top\">{{ row.details_of_property or \"-\" }}</td>\n                            <td align=\"center\" valign=\"middle\">{{ row.get_formatted(\"present_value\") }}</td>\n                            <td align=\"left\" valign=\"top\">\n                                {% if row.spouce_name %}\n                                    {{ row.spouce_name }}<br>\n                                    <span style=\"font-size: 9px;\">({{ row.spouce_relation }})</span>\n                                {% else %}\n                                    Self\n                                {% endif %}\n                            </td>\n                            <td align=\"left\" valign=\"top\">{{ row.how_acquired_whether or \"-\" }}</td>\n                            <td align=\"center\" valign=\"middle\">{{ row.get_formatted(\"income_from_the_property\") }}</td>\n                            <td align=\"left\" valign=\"top\">{{ row.remarks or \"\" }}</td>\n                        </tr>\n                        {% endfor %}\n                    {% else %}\n                        <tr>\n                            <td colspan=\"8\" align=\"center\" style=\"padding: 30px;\">No data available in table</td>\n                        </tr>\n                    {% endif %}\n                </tbody>\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td style=\"padding-top: 40px;\">\n            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                    <td width=\"50%\"></td> <!-- Empty Left -->\n                    <td width=\"50%\">\n                        <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"4\">\n                            <tr>\n                                <td align=\"right\">Name:</td>\n                                <td align=\"center\" style=\"border-bottom: 1px dotted #000; font-weight: bold;\">\n                                    {{ frappe.db.get_value(\"Employee\", doc.employee, \"employee_name\") }}\n                                </td>\n                            </tr>\n                            <tr>\n                                <td align=\"right\">Place of posting:</td>\n                                <td align=\"center\" style=\"border-bottom: 1px dotted #000; font-weight: bold;\">\n                                    HEAD OFFICE\n                                </td>\n                            </tr>\n                            <tr>\n                                <td align=\"right\">Date:</td>\n                                <td align=\"center\" style=\"border-bottom: 1px dotted #000; font-weight: bold;\">\n                                    {{ frappe.utils.formatdate(doc.creation) }}\n                                </td>\n                            </tr>\n                        </table>\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n\n    <tr>\n        <td style=\"padding-top: 40px; font-size: 11px; color: #333;\">\n            <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"2\">\n                <tr>\n                    <td><strong>Notes:</strong></td>\n                </tr>\n                <tr>\n                    <td>\n                        <ol style=\"margin-top: 5px; padding-left: 20px;\">\n                            <li style=\"margin-bottom: 4px;\">(*) In case where it is not possible to assess the value accurately, the approximate value in relation to present condition may be indicated.</li>\n                            <li style=\"margin-bottom: 4px;\">(**) Includes short-term lease also.</li>\n                            <li style=\"margin-bottom: 4px;\">The declaration form is required to be filled in and submitted by every employee under relevant provision of Conduct Rules and the first appointment to the service and thereafter, at the interval of every twelve months, giving particulars of all immovable property owned, acquired or inherited by him or held by him/her on lease or mortgage, either in his/her own name or in the name of any member of his/her family.</li>\n                            <li style=\"margin-bottom: 4px;\">The wording \"No change or No addition or as in previous year\" may be avoided and all details filled up.</li>\n                        </ol>\n                    </td>\n                </tr>\n                <tr>\n                    <td align=\"center\" style=\"padding-top: 20px; font-size: 10px; color: #666;\">\n                        Power By: Copyright 2025 Nafed-India.com, All rights Reserved\n                    </td>\n                </tr>\n            </table>\n        </td>\n    </tr>\n\n</table>",
