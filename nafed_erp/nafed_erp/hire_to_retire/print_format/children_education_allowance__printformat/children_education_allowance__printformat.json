 "font_size": 14,
 "html": "<div>\n    {% if letter_head and not no_letterhead %}\n            <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n\n</div>\n{% block content %}\n<table style=\"width: 100%; font-size: 15px; line-height: 1.6; border-collapse: collapse;\">\n    <tr>\n    <td colspan=\"2\" style=\"text-align: center;\">\n        <div style=\"font-size: 16px; font-weight: bold; line-height: 1.4; margin-bottom: 0px;\">\n            National Agricultural Cooperative Marketing Federation of India Ltd.<br>\n            NAFED House, Siddhartha Enclave, Ring Road, Ashram Chowk,<br>\n            New Delhi-110014\n        </div>\n    </td>\n</tr>\n\n<tr>\n    <td colspan=\"2\" style=\"text-align: center; text-decoration: underline; padding: 1!important;\"\">\n        <div style=\"font-size: 18px; font-weight: bold; margin-top: 1px;\">\n            Application for Reimbursement of Children Education Allowance\n        </div>\n    </td>\n</tr>\n\n\n    <tr>\n        <td colspan=\"2\">\n            <p>\n                I certify that my child/children in respect of whom Children Education Allowance is claimed\n                is/are wholly dependent upon me and is/are studying in the school(s) and class(es) as under:\n            </p>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <table style=\"width: 100%; font-size: 15px; border-collapse: collapse; margin-top: 10px; table-layout: fixed;\">\n                <thead>\n                    <tr>\n                        <th style=\"border: 2px solid #000; width: 11%; white-space: nowrap;\">Name of Child*</th>\n                        <th style=\"border: 2px solid #000; width: 10%; white-space: nowrap;\">Date of Birth*</th>\n                        <th style=\"border: 2px solid #000; width: 14%; word-wrap: break-word; white-space: normal; text-align: center;\">\n                            School in which<br>Studying*\n                        </th>\n                        <th style=\"border: 2px solid #000; width: 11%; word-wrap: break-word; white-space: normal; text-align: center;\">\n                            Class in which<br>Studying*\n                        </th>\n                        <th style=\"border: 2px solid #000; width: 12%; word-wrap: break-word; white-space: normal; text-align: center;\">\n                            Not Applicable*\n                        </th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for row in doc.children_details %}\n                    <tr>\n                        <td style=\"border: 2px solid #000; white-space: nowrap;\">{{ row.child_name }}</td>\n                        <td style=\"border: 2px solid #000; white-space: nowrap;\">{{ row.date_of_birth }}</td>\n                        <td style=\"border: 2px solid #000; white-space: nowrap;\">{{ row.school_name }}</td>\n                        <td style=\"border: 2px solid #000; white-space: nowrap;\">{{ row.class_studying_in }}</td>\n                        <td style=\"border: 2px solid #000; text-align: center; white-space: nowrap; padding: 4px;\">\n                            {% if row.not_applicable %}&#10004;{% else %}&nbsp;{% endif %}\n                        </td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n        </td>\n    </tr>\n\n    <tr><td colspan=\"2\" style=\"height: 15px;\"></td></tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <p>\n                1. The Amount of Rs.. <strong>{{doc.amount}}. </strong> for children education allowance admissible vide Officer Order No.<strong>{{doc.order_no}}</strong> dated <strong>{{doc.date_of_application}}</strong>\n                may please paid to me.\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\">\n            <p>\n                2. I also certify that my wife/husband is not in NAFED/Govt. service and that no allowance has\n                been claimed by her/him from Government/NAFED (strike out whichever is not applicable).\n            </p>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <p>\n               <b>3. Original Document</b><br>\n                a. I enclose original receipt No. <strong>{{ doc.original_receipt_no  }}</strong> dated\n                <strong>{{ doc.date_of_application }}</strong> issued by the School authorities toward\n                payment of fees of my above mentioned child/children for <strong>{{ frappe.utils.formatdate(doc.date_of_application, \"MMMM.yyyy\") or '' }}</strong>.\n\n                \n            </p>\n        </td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\">\n            <p>\n                4. No bill/receipt is being issued by the school authorities. I am, therefore, enclosing a certificate\n                from school of my above mentioned child/children in the prescribed proforma.\n        <b>Upload Receipt/Bill No.</b>\n        <br>\n        {{doc.upload_receiptno}}</br>\n            </p>\n        </td>\n    </tr>\n\n    \n  <tr><td colspan=\"1\" style=\"height:5px;\"></td></tr>\n\n<tr>\n    <td style=\"width: 60%;\"></td>\n    <td style=\"text-align: left; vertical-align: top;\">\n        <table style=\"border-collapse: collapse; width: 100%; line-height: 1; font-size: 15px;\">\n            <tr>\n                <td style=\"padding: 2!important;\"><strong>Name of Employee:</strong></td>\n                <td style=\"padding: 2!important;\">{{ doc.employee_name }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 2!important;\"><strong>Designation:</strong></td>\n                <td style=\"padding: 2!important;\">{{ doc.designation }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 2!important;\"><strong>Dated:</strong></td>\n                <td style=\"padding: 2!important;\">{{ doc.date_of_application }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 2!important;\"><strong>Section:</strong></td>\n                <td style=\"padding: 2!important;\">{{ doc.section }}</td>\n            </tr>\n            <tr>\n                <td style=\"padding: 2!important;\"><strong>Office:</strong></td>\n                <td style=\"padding: 2!important;\">{{ doc.company }}</td>\n            </tr>\n        </table>\n    </td>\n</tr>\n\n\n</table>\n{% endblock %}\n",
